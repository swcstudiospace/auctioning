# /etc/auctioning/api.env — root:root 0600. Copy, fill, never commit.
# Generate secrets: openssl rand -base64 32 | tr -d '/+=' | cut -c1-40

POSTGRES_PASSWORD=
APP_ENV=prod
APP_DOMAIN=auctioning.lol
# Exact origins, comma-separated. Vercel preview URLs are not wildcarded on
# purpose: add a stable preview alias if you need one.
ALLOWED_ORIGINS=https://auctioning.lol,https://www.auctioning.lol
INGEST_SECRET=
OPERATOR_TOKEN=
WHOP_WEBHOOK_SECRET=
WHOP_API_KEY=
# dollars (19.9 = $19.90) or cents — confirm on the first real delivery.
WHOP_AMOUNT_UNIT=dollars
WEEKLY_FREE_RP=50
RATE_LIMIT_PER_MIN=60
PROGRAM_ID=3GGYRVymmKQhmxP9nw9yPs8HCf7YWw7WViPjkKFkZNGs
MAINNET_RPC=https://api.mainnet-beta.solana.com
ER_RPC=https://devnet-er.magicblock.app
# Empty keeps the worker on ping-only.
ER_WS=
# Leave empty until the settle path is live; then load from a secret store.
AUTHORITY_SECRET=
MAX_RACE_SECS=300
NARRATIVE_LLM_URL=
NARRATIVE_LLM_KEY=
SUPERGROK_AUTHORIZE_URL=https://grok.ego.engineer/authorize
SUPERGROK_TOKEN_URL=https://grok.ego.engineer/token
SUPERGROK_CLIENT_ID=grok
SUPERGROK_REDIRECT_URI=https://api-auctioning.swcstudio.space/v1/oauth/supergrok/callback
SUPERGROK_COMPLETION_URL=
RUST_LOG=info,sqlx=warn,tower_http=info
