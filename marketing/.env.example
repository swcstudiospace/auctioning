NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave empty to use same-origin /v1 (Next rewrites to the API).
# Set to the public Shuttle URL only when marketing and API are on different hosts.
NEXT_PUBLIC_API_URL=
# Server-side fetch + rewrite target. Local default is the API runner.
# On Vercel Production/Preview this MUST be the public Shuttle URL
# (https://<project>.shuttle.app), not 127.0.0.1 — otherwise /rank 404s the catalog.
AUCTIONING_INTERNAL_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WHOP_CHECKOUT_URL=
