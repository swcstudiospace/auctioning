# Copy to `.env`. Values here are local defaults, not production secrets.
# Key material is path-only — never paste keypair bytes or JSON secret arrays.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/auctioning
# dev | staging | prod. Outside dev the gates below are mandatory.
APP_ENV=dev
APP_DOMAIN=auctioning.lol
# Comma-separated exact origins. Empty = permissive (dev only).
ALLOWED_ORIGINS=
# ≥16 chars each outside dev.
OPERATOR_TOKEN=
# dev only: honour X-Auctioning-Dev-Wallet instead of a signed session
AUTH_DEV_BYPASS=false
RATE_LIMIT_PER_MIN=60
# dollars (19.9 = $19.90) or cents
WHOP_AMOUNT_UNIT=dollars
WHOP_WEBHOOK_SECRET=
ON_CHAIN_ENABLED=false
AUTHORITY_KEYPAIR_PATH=./keys/auctioning-keypair.json
SOLANA_RPC_URL=http://127.0.0.1:8899
PROGRAM_ID=3GGYRVymmKQhmxP9nw9yPs8HCf7YWw7WViPjkKFkZNGs
WEEKLY_FREE_RP=50
INGEST_SECRET=
# Optional. Empty = templates only. Never commit real keys.
NARRATIVE_LLM_URL=
NARRATIVE_LLM_KEY=
ER_RPC=https://devnet-er.magicblock.app
ER_WS=wss://devnet-er.magicblock.app
AUTHORITY_SECRET=
MAX_RACE_SECS=300
# Public client + PKCE. Register SUPERGROK_REDIRECT_URI on grok.ego.engineer.
SUPERGROK_AUTHORIZE_URL=https://grok.ego.engineer/authorize
SUPERGROK_TOKEN_URL=https://grok.ego.engineer/token
SUPERGROK_CLIENT_ID=grok
SUPERGROK_CLIENT_SECRET=
SUPERGROK_REDIRECT_URI=http://127.0.0.1:8000/v1/oauth/supergrok/callback
SUPERGROK_COMPLETION_URL=
