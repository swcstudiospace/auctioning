# Copy to `.env`. Values here are local defaults, not production secrets.
# Key material is path-only — never paste keypair bytes or JSON secret arrays.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/auctioning
WHOP_WEBHOOK_SECRET=
ON_CHAIN_ENABLED=false
AUTHORITY_KEYPAIR_PATH=~/.config/solana/id.json
SOLANA_RPC_URL=http://127.0.0.1:8899
PROGRAM_ID=
WEEKLY_FREE_RP=100
INGEST_SECRET=
# Optional. Empty = templates only. Never commit real keys.
NARRATIVE_LLM_URL=
NARRATIVE_LLM_KEY=
